# secret-shaped: never in this repo (secrets.sh says where they live: $SECRETS, default ~/.secrets)
.secrets/
*.key
*_api_key
*api_key*
*.pem
id_*
*_ed25519
*_ed25519.pub
*_rsa
*.env
.env*
config.json
# python
__pycache__/
*.egg-info/
build/
dist/
# references: only INDEX.md is tracked; mirrors and downloads are re-made by tools/ (keep scripts, not scrapes)
references/**
!references/**/
!references/**/INDEX.md
